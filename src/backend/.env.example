# 应用配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 数据库配置
DATABASE_URL="postgresql://novel_writer:password@localhost:5432/novel_writer_db?schema=public"

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
# ⚠️ WARNING: 在生产环境中必须设置强密钥（至少 32 字符）
# 生产环境启动时会验证密钥安全性
JWT_SECRET=dev-jwt-secret-not-for-production-use-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 加密配置
BCRYPT_SALT_ROUNDS=10
# ⚠️ WARNING: 在生产环境中必须设置恰好 32 字符的密钥
# 生产环境启动时会验证密钥长度
AES_ENCRYPTION_KEY=dev-aes-key-32-chars-not-for-production

# API 配置
API_PREFIX=/api/v1

# 限流配置
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# 日志配置
LOG_LEVEL=info

# CORS 配置
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
