# ============================================
# Docker 构建忽略文件
# ============================================
# 排除不需要复制到 Docker 镜像的文件

# 依赖目录
node_modules/
**/node_modules/

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 测试相关
coverage/
.nyc_output/
*.lcov

# 环境配置文件
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~

# Git 相关
.git/
.gitignore
.gitattributes

# Docker 相关
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore

# 文档
docs/
*.md
README.md
LICENSE

# 测试文件
**/__tests__/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
tests/
test/

# 临时文件
tmp/
temp/
*.tmp
*.temp

# 操作系统文件
.DS_Store
Thumbs.db

# 编辑器备份文件
*.bak
*.backup

# 前端相关（如果后端不需要）
src/frontend/
src-tauri/
public/

# 其他项目文件
.opencode/
.agents/
.mem0.json

# 备份文件
*.sql.gz
*.backup
backups/
