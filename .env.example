# AI 服务配置示例

# 应用配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 数据库配置
DATABASE_URL=postgresql://localhost:5432/novel_writer

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 加密配置
BCRYPT_SALT_ROUNDS=10
AES_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# 限流配置
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# 日志配置
LOG_LEVEL=info

# ============ AI 服务配置 ============

# OpenAI API（用于错别字检测、大纲生成）
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API（用于大纲生成、正文生成）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Stable Diffusion API（用于封面生成）
# 选择以下任意一个即可

# 1. Stability AI
STABILITY_API_KEY=sk-your-stability-api-key-here
STABILITY_BASE_URL=https://api.stability.ai/v1

# 2. Replicate
REPLICATE_API_TOKEN=r8_your-replicate-api-token-here

# 3. 火山引擎（备选）
VOLCENGINE_API_KEY=your-volcengine-api-key-here

# 本地模型配置（可选）
LOCAL_MODEL_PATH=/path/to/local/models

# AI 功能限流配置
AI_SPELL_CHECK_RATE_LIMIT=100
AI_OUTLINE_GEN_RATE_LIMIT=50
AI_COVER_GEN_RATE_LIMIT=10
