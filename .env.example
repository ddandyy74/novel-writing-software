# Node.js 后端 .env 示例
NODE_ENV=production
PORT=3000

# 数据库
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/novel_writer
POSTGRES_PASSWORD=your-password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-key-here

# Sentry (错误追踪)
SENTRY_DSN_BACKEND=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_DSN_FRONTEND=https://your-sentry-dsn@sentry.io/your-project-id

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# CORS
CORS_ORIGIN=http://localhost:1420

# 日志级别
LOG_LEVEL=info
